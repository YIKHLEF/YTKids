<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Child-friendly) -->
    <style name="Base.Theme.YouTubeKids" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.YouTubeKids" parent="Base.Theme.YouTubeKids" />

    <!-- Admin Theme -->
    <style name="Theme.YouTubeKids.Admin" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorPrimaryDark">@color/admin_dark</item>
        <item name="colorAccent">@color/admin_accent</item>
    </style>

    <!-- Fullscreen Player Theme -->
    <style name="Theme.YouTubeKids.Player" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorPrimary">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <!-- Card Style -->
    <style name="VideoCardStyle">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- Button Styles -->
    <style name="ChildButton" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:padding">16dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Text Styles -->
    <style name="VideoTitleText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="EmptyStateText">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAlignment">center</item>
    </style>
</resources>
